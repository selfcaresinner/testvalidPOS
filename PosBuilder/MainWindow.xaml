<Window x:Class="PosBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PosBuilder - Empaquetador de POS" Height="850" Width="700"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="HeaderStyle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PosBuilder: Editor y Empaquetador" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" Foreground="#0F172A"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                
                <!-- Tenant y Conexión (Backend &amp; Frontend) -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="1. Configuración de Entorno (Railway &amp; POS Cliente)" Style="{StaticResource HeaderStyle}"/>
                        
                        <TextBlock Text="Tenant ID (Desglose de Comercios):" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="Selecciona el comercio para adaptar el POS y la base de datos." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbTenants" Height="38" Margin="0,0,0,15" Padding="5" VerticalContentAlignment="Center" FontSize="14">
                            <ComboBoxItem Content="Cafetería y Postres (CAFFE_SHOP_001)" Tag="CAFFE_SHOP_001" IsSelected="True"/>
                            <ComboBoxItem Content="Boutique / Ropa (RETAIL_FASHION_001)" Tag="RETAIL_FASHION_001"/>
                            <ComboBoxItem Content="Ferretería y Materiales (HARDWARE_STORE_001)" Tag="HARDWARE_STORE_001"/>
                            <ComboBoxItem Content="Mini Super / Abarrotes (MINI_MARKET_001)" Tag="MINI_MARKET_001"/>
                            <ComboBoxItem Content="Restaurante y Comida Rápida (RESTAURANT_001)" Tag="RESTAURANT_001"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="API Base URL (Para PosCore.exe):" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtApiBaseUrl" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PORT (Para Railway Backend):" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtPort" Text="8080" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="DATABASE_URL (o ConnectionStrings__DefaultConnection):" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TxtDatabaseUrl" Text="Host=my_host;Database=my_db;Username=my_user;Password=my_pw" Height="38" Margin="0,0,0,15" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Jwt__Issuer:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtJwtIssuer" Text="PosServer" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Jwt__Audience:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtJwtAudience" Text="PosClient" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Jwt__Key (Clave Secreta para Tokens):" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="PwdSecretKey" Height="38" Margin="0,0,0,10" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Border>

                
                <!-- Usuarios Iniciales -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Usuarios Iniciales (Admin y Empleado)" Style="{StaticResource HeaderStyle}"/>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Admin Username:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtAdminUsername" Text="admin" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Admin PIN:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtAdminPin" Text="admin123" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Employee Username:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtEmployeeUsername" Text="cajero" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Employee PIN:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TxtEmployeePin" Text="1234" Height="38" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Identidad y Branding -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="2. Identidad y Branding del Cliente" Style="{StaticResource HeaderStyle}"/>
                        
                        <TextBlock Text="Nombre del Comercio:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TxtStoreName" Height="38" Margin="0,0,0,15" Padding="8,0" VerticalContentAlignment="Center" FontSize="14" BorderBrush="#CBD5E1"/>

                        <TextBlock Text="Logo de la Marca (.png, .jpg):" Style="{StaticResource LabelStyle}"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtLogoPath" Height="38" IsReadOnly="True" VerticalContentAlignment="Center" Padding="8,0" Background="#F1F5F9" BorderBrush="#CBD5E1"/>
                            <Button Grid.Column="1" Content="Explorar..." Margin="10,0,0,0" Click="BtnSelectLogo_Click" Background="#E2E8F0" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                        <Image x:Name="ImgPreview" Height="60" HorizontalAlignment="Left" Margin="0,0,0,15" Stretch="Uniform"/>

                        <TextBlock Text="Color Primario de la UI (Selecciona o escribe Hex):" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="CmbPrimaryColor" Height="38" Margin="0,0,0,10" Padding="5" VerticalContentAlignment="Center" FontSize="14" IsEditable="True">
                            <ComboBoxItem Content="Azul Corporativo (#1976D2)"/>
                            <ComboBoxItem Content="Verde Éxito (#10B981)"/>
                            <ComboBoxItem Content="Naranja Dinámico (#F59E0B)"/>
                            <ComboBoxItem Content="Rosa Caffenio (#EC4899)"/>
                            <ComboBoxItem Content="Rojo Peligro (#EF4444)"/>
                            <ComboBoxItem Content="Gris Oscuro (#374151)"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Módulos y Métodos de Pago -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="3. Módulos Activos" Style="{StaticResource HeaderStyle}"/>
                            <CheckBox x:Name="ChkCoupons" Content="Cupones y Promociones" Margin="0,0,0,10" FontSize="14"/>
                            <CheckBox x:Name="ChkLoyalty" Content="Sistema de Lealtad (Puntos)" Margin="0,0,0,10" FontSize="14"/>
                            <CheckBox x:Name="ChkInventory" Content="Control de Inventario Local" IsChecked="True" Margin="0,0,0,10" FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="4. Métodos de Pago" Style="{StaticResource HeaderStyle}"/>
                            <CheckBox x:Name="ChkCash" Content="Efectivo (Caja)" IsChecked="True" Margin="0,0,0,10" FontSize="14"/>
                            <CheckBox x:Name="ChkCard" Content="Tarjeta (Terminal)" IsChecked="True" Margin="0,0,0,10" FontSize="14"/>
                            <CheckBox x:Name="ChkTransfer" Content="Transferencia Bancaria" Margin="0,0,0,10" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Botón de Empaquetar -->
        <Button Grid.Row="2" x:Name="BtnGenerate" Content="🚀 Construir y Empaquetar POS (Setup.exe)" 
                Height="54" Margin="0,20,0,20" Background="#2563EB" Foreground="White" 
                FontSize="18" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnGenerate_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- Consola -->
        <Border Grid.Row="3" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1">
            <ScrollViewer x:Name="SvLog" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtLog" Foreground="#10B981" FontFamily="Consolas" FontSize="13" Padding="15" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
