<Window x:Class="PosCore.Views.ShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:PosCore.ViewModels"
        xmlns:converters="clr-namespace:PosCore.Converters"
        mc:Ignorable="d"
        Title="Arqueo y Control de Turnos - POS Express" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F3F4F6">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:LessThanZeroConverter x:Key="LessThanZeroConverter"/>
    </Window.Resources>
    
    <Grid Margin="25">
        <Border Background="White" CornerRadius="12" Padding="30" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" />
            </Border.Effect>
            <Grid>
                <!-- Apertura de Turno -->
                <StackPanel Visibility="{Binding HasActiveShift, Converter={StaticResource InverseBooleanToVisibilityConverter}}" VerticalAlignment="Center">
                    <TextBlock Text="Apertura de Turno" FontSize="26" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Declare el monto inicial en caja." FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    
                    <TextBlock Text="Fondo de Caja Inicial" FontSize="14" Foreground="#4B5563" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding StartingCash, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                             FontSize="24" FontWeight="Bold" Padding="15" Margin="0,0,0,30" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" Foreground="#111827" HorizontalContentAlignment="Right"/>
                    
                    <Button Content="Abrir Turno" Command="{Binding OpenShiftCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#10B981" Foreground="White" FontSize="18" FontWeight="Bold" Height="55" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                
                <!-- Cierre de Turno -->
                <StackPanel Visibility="{Binding HasActiveShift, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                    <TextBlock Text="Cierre de Turno" FontSize="26" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <TextBlock Text="Declare el monto final contado en caja." FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    
                    <Border Margin="0,0,0,30" Background="#F9FAFB" Padding="20" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Total Físico en Caja:" FontSize="18" FontWeight="SemiBold" Foreground="#4B5563" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding ActualEndingCash, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" 
                                     Width="120" FontSize="20" FontWeight="Bold" Padding="5,10" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" HorizontalContentAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                                        <Button Content="Retirar Efectivo / Salida" Command="{Binding RegisterWithdrawalCommand}" 
                            Background="#F59E0B" Foreground="White" FontSize="16" FontWeight="Bold" Height="45" Margin="0,0,0,15" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Cerrar Turno" Command="{Binding CloseShiftCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#EF4444" Foreground="White" FontSize="18" FontWeight="Bold" Height="55" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
