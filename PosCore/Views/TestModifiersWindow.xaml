<Window x:Class="PosCore.Views.TestModifiersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personalizar Producto" Height="600" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="20" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="ProductNameText" Text="Café Capuccino" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock x:Name="ProductPriceText" Text="$65.00" FontSize="18" Foreground="#6B7280" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Modifiers List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ModifiersPanel" Margin="10">
                <!-- Dynamic Content Will Go Here -->
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" Padding="20" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Total:" FontSize="14" Foreground="#6B7280"/>
                    <TextBlock x:Name="TotalPriceText" Text="$65.00" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Agregar a la Orden" Width="180" Height="45" Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
