<Window x:Class="PosCore.Views.ItemModifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modificar Producto" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="ProductNameText" Text="Producto" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,15"/>
        
        <TextBlock Text="Notas / Modificadores (ej. Sin cebolla, extra queso):" FontSize="14" Foreground="#374151" Margin="0,0,0,5" Grid.Row="1"/>
        <TextBox x:Name="NotesBox" Grid.Row="2" FontSize="14" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>
        
        <TextBlock Text="Descuento Directo al Producto ($):" FontSize="14" Foreground="#374151" Margin="0,0,0,5" Grid.Row="3"/>
        <TextBox x:Name="DiscountBox" Grid.Row="4" FontSize="16" Height="35" Padding="5" Text="0.00" Margin="0,0,0,15"/>
        
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Button Content="Cancelar" Width="90" Height="35" Margin="0,0,10,0" Background="#E5E7EB" BorderThickness="0" Click="BtnCancel_Click"/>
            <Button Content="Guardar Cambios" Width="130" Height="35" Background="#3B82F6" Foreground="White" BorderThickness="0" Click="BtnSave_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
