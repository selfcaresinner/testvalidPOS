<Window x:Class="PosCore.Views.WithdrawalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retiro de Efectivo" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Registrar Retiro / Salida" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <TextBlock Text="Monto a retirar:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="AmountBox" FontSize="18" Padding="5" Margin="0,0,0,15" Background="#F9FAFB"/>
                
                <TextBlock Text="Motivo:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="ReasonBox" FontSize="14" Padding="5" Margin="0,0,0,25" Background="#F9FAFB" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Width="100" Height="40" Margin="0,0,10,0" Background="#E5E7EB" BorderThickness="0" Click="BtnCancel_Click"/>
                    <Button Content="Confirmar" Width="120" Height="40" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnConfirm_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
