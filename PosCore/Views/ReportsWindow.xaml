<Window x:Class="PosCore.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Reportes Avanzados" Height="750" Width="1000" WindowStartupLocation="CenterOwner" Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header & Filters -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="Reportes Avanzados" FontSize="28" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#4B5563"/>
                <DatePicker SelectedDate="{Binding StartDate}" Width="110" Margin="0,0,15,0" Background="White"/>
                
                <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#4B5563"/>
                <DatePicker SelectedDate="{Binding EndDate}" Width="110" Margin="0,0,15,0" Background="White"/>
                
                <Button Content="Filtrar" Command="{Binding LoadDataCommand}" Width="80" Padding="5,8" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="Excel" Command="{Binding ExportToCsvCommand}" Width="60" Padding="5,8" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                <Button Content="PDF" Command="{Binding ExportEndOfDayPdfCommand}" Width="60" Padding="5,8" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
        
        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Ingresos del Periodo" FontSize="16" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding PeriodTotalRevenue, StringFormat={}{0:C}}" FontSize="28" FontWeight="Bold" Foreground="#10B981" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Órdenes del Periodo" FontSize="16" Foreground="#6B7280"/>
                    <TextBlock Text="{Binding PeriodTotalOrders}" FontSize="28" FontWeight="Bold" Foreground="#3B82F6" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Tabs for Details -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="-4,0,-4,0">
            
            <TabItem Header="Ventas por Día" FontSize="16">
                <Grid Margin="4,10,4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding DailySales}" Height="150" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,0" VerticalAlignment="Bottom" ToolTip="{Binding TotalRevenue, StringFormat=C}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#10B981" Width="30" VerticalAlignment="Bottom" Height="{Binding ChartHeight}" CornerRadius="4,4,0,0" />
                                    <TextBlock Grid.Row="1" Text="{Binding Date, StringFormat='dd/MM'}" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="11" Foreground="#6B7280"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding DailySales}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="White" RowHeight="40" AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat='dd/MM/yyyy'}" Width="*"/>
                            <DataGridTextColumn Header="Órdenes" Binding="{Binding TotalOrders}" Width="*"/>
                            <DataGridTextColumn Header="Ingresos Totales" Binding="{Binding TotalRevenue, StringFormat={}{0:C}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            
            <TabItem Header="Productos Más Vendidos" FontSize="16">
                <DataGrid ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="4,10,4,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Cantidad Vendida" Binding="{Binding QuantitySold}" Width="*"/>
                        <DataGridTextColumn Header="Ingresos Generados" Binding="{Binding TotalRevenue, StringFormat={}{0:C}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Métodos de Pago" FontSize="16">
                <DataGrid ItemsSource="{Binding PaymentMethods}" AutoGenerateColumns="False" IsReadOnly="True" Margin="4,10,4,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Método" Binding="{Binding Method}" Width="2*"/>
                        <DataGridTextColumn Header="Transacciones" Binding="{Binding TransactionCount}" Width="*"/>
                        <DataGridTextColumn Header="Ingresos" Binding="{Binding TotalRevenue, StringFormat={}{0:C}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Historial de Arqueos" FontSize="16">
                <DataGrid ItemsSource="{Binding ShiftHistory}" AutoGenerateColumns="False" IsReadOnly="True" Margin="4,10,4,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Apertura" Binding="{Binding OpenedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                        <DataGridTextColumn Header="Cierre" Binding="{Binding ClosedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                        <DataGridTextColumn Header="Usuario" Binding="{Binding OpenedBy}" Width="*"/>
                        <DataGridTextColumn Header="Fondo" Binding="{Binding StartingCash, StringFormat={}{0:C}}" Width="*"/>
                        <DataGridTextColumn Header="Diferencia" Binding="{Binding Difference, StringFormat={}{0:C}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Movimientos de Caja" FontSize="16">
                <DataGrid ItemsSource="{Binding CashMovements}" AutoGenerateColumns="False" IsReadOnly="True" Margin="4,10,4,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="*"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat={}{0:C}}" Width="*"/>
                        <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            
            <TabItem Header="Alerta: Bajo Stock" FontSize="16">
                <DataGrid ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="4,10,4,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#FEF2F2" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="*"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockQuantity}" Width="*"/>
                        <DataGridTextColumn Header="Umbral Min." Binding="{Binding MinStockThreshold}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
