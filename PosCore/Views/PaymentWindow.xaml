<Window x:Class="PosCore.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar Venta - POS Express" Height="750" Width="1000"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Column: Details -->
        <Border Grid.Column="0" Margin="0,0,25,0" Background="White" CornerRadius="12" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,25">
                    <TextBlock Text="Total a Cobrar" FontSize="20" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalText" Text="$0.00" FontSize="56" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                    
                    <TextBlock Text="Restante por Pagar" FontSize="20" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                    
                    <TextBlock x:Name="RemainingText" Text="$0.00" FontSize="48" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TipText" Text="Propina: $0.00" FontSize="20" FontWeight="SemiBold" Foreground="#8B5CF6" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>

                </StackPanel>
                <GroupBox Grid.Row="1" Header="Pagos Aplicados" FontSize="18" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,25" BorderBrush="#D1D5DB">
                    <ListView x:Name="PaymentsList" BorderThickness="0" Margin="10" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F9FAFB" CornerRadius="8" Padding="15" Margin="0,5" BorderBrush="#E5E7EB" BorderThickness="1" Width="380">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Method}" FontSize="18" FontWeight="Medium" Foreground="#1F2937" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=C}" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="15,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="✕" Width="35" Height="35" Background="#FEE2E2" Foreground="#EF4444" FontWeight="Bold" BorderThickness="0" 
                                                Click="BtnRemovePayment_Click" Tag="{Binding}" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="17.5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </GroupBox>
                <Border Grid.Row="2" Background="#ECFDF5" Padding="20" Margin="-25,0,-25,-25"><StackPanel>
                    <TextBlock x:Name="ChangeText" Text="Cambio: $0.00" FontSize="32" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Center" Visibility="Hidden"/>
                </StackPanel></Border>
            </Grid>
        </Border>
        <!-- Right Column: Numpad & Actions -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Monto a Ingresar" FontSize="18" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TenderedText" Text="$0.00" FontSize="48" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,10,0,25"/>
                </StackPanel>
                <!-- Touch Numpad -->
                <Grid x:Name="NumpadGrid" Grid.Row="1" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid.Resources>
                        <Style TargetType="Button">
                            <Setter Property="FontSize" Value="28"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Background" Value="#F3F4F6"/>
                            <Setter Property="Foreground" Value="#111827"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="4"/>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </Grid.Resources>
                    <!-- Numpad digits -->
                    <Button Content="7" Grid.Row="0" Grid.Column="0" Click="BtnNum_Click"/>
                    <Button Content="8" Grid.Row="0" Grid.Column="1" Click="BtnNum_Click"/>
                    <Button Content="9" Grid.Row="0" Grid.Column="2" Click="BtnNum_Click"/>
                    
                    <Button Content="4" Grid.Row="1" Grid.Column="0" Click="BtnNum_Click"/>
                    <Button Content="5" Grid.Row="1" Grid.Column="1" Click="BtnNum_Click"/>
                    <Button Content="6" Grid.Row="1" Grid.Column="2" Click="BtnNum_Click"/>
                    
                    <Button Content="1" Grid.Row="2" Grid.Column="0" Click="BtnNum_Click"/>
                    <Button Content="2" Grid.Row="2" Grid.Column="1" Click="BtnNum_Click"/>
                    <Button Content="3" Grid.Row="2" Grid.Column="2" Click="BtnNum_Click"/>
                    
                    <Button Content="0" Grid.Row="3" Grid.Column="0" Click="BtnNum_Click"/>
<Button Content="00" Grid.Row="3" Grid.Column="1" Click="BtnNum_Click"/>
                    <Button Content="Borrar" Grid.Row="3" Grid.Column="2" FontSize="18" Background="#FEE2E2" Foreground="#DC2626" Click="BtnClear_Click"/>
                    <Button Content="Propina" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" FontSize="18" Background="#8B5CF6" Foreground="White" Click="BtnAddTip_Click"/>
                    <!-- Payment Methods -->
                    <Button Content="💵 Efectivo" Grid.Row="0" Grid.Column="3" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="18" Click="BtnAddPayment_Click" Tag="Efectivo"/>
                    <Button Content="💳 Tarjeta" Grid.Row="1" Grid.Column="3" Background="#3B82F6" Foreground="White" BorderThickness="0" FontSize="18" Click="BtnAddPayment_Click" Tag="Tarjeta"/>
                    <Button Content="📱 Transf." Grid.Row="2" Grid.Column="3" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontSize="18" Click="BtnAddPayment_Click" Tag="Transferencia"/>
                    <Button Content="Exacto" Grid.Row="3" Grid.Column="3" Background="#F59E0B" Foreground="White" BorderThickness="0" FontSize="18" Click="BtnExact_Click"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Cancelar (ESC)" Grid.Column="0" Height="60" Margin="0,0,10,0" Background="#E5E7EB" Foreground="#374151" FontSize="20" FontWeight="Bold" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
                    <Button Content="Completar (ENTER)" Grid.Column="1" Height="60" Background="#111827" Foreground="White" FontWeight="Bold" FontSize="22" BorderThickness="0" Click="BtnPay_Click" IsDefault="True" Cursor="Hand"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
