<Window x:Class="PosCore.Views.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestión de Usuarios" Height="500" Width="700" WindowStartupLocation="CenterOwner" Background="#F3F4F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Gestión de Usuarios / Cajeros" FontSize="24" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20"/>
        
        <!-- Add New User Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nombre de Usuario" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="PIN (ej. 1234)" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewPin, UpdateSourceTrigger=PropertyChanged}" Padding="5" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Rol" Foreground="#4B5563" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Padding="5" FontSize="14" BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>

                <Button Grid.Column="3" Content="Guardar" Command="{Binding AddUserCommand}" 
                        Background="#10B981" Foreground="White" FontWeight="Bold" Padding="15,0" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom" Height="30"/>
            </Grid>
        </Border>

        <!-- Users List -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="White" RowHeight="40" AlternatingRowBackground="#F9FAFB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB" HeadersVisibility="Column" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="2*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="*"/>
                <DataGridTextColumn Header="PIN" Binding="{Binding Pin}" Width="*"/>
                
                <DataGridTemplateColumn Header="Acciones" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Editar" Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,5" Margin="5"/>
                                <Button Content="Reset PIN" Command="{Binding DataContext.ResetPinCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Background="#F59E0B" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,5" Margin="5"/>
                                <Button Content="Eliminar" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                        Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="10,5" Margin="5"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
