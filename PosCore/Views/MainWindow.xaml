<Window x:Class="PosCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        xmlns:vm="clr-namespace:PosCore.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Settings.WhiteLabel.CompanyName, StringFormat='{}POS - {0}'}" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}" />
        <KeyBinding Key="F4" Command="{Binding OpenShiftCommand}" />
        <KeyBinding Key="F2" Command="{Binding SuspendOrderCommand}" />
        <KeyBinding Key="F1" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F3" Command="{Binding ResumeOrderCommand}" />
        <KeyBinding Key="F5" Command="{Binding OpenReturnsCommand}" />
        <KeyBinding Key="F6" Command="{Binding OpenReportsCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenUsersCommand}" />
        <KeyBinding Key="F8" Command="{Binding OpenInventoryCommand}" />
    </Window.InputBindings>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Header for Network & Sync Status -->
        <Border Background="{Binding PrimaryColorBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Settings.WhiteLabel.CompanyName, StringFormat='{}☕ {0}'}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙️" Command="{Binding ConfigurePrinterCommand}" Width="30" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,15,0" ToolTip="Configurar Impresora" Cursor="Hand" FontSize="16"/>
                    <Ellipse Width="10" Height="10" Fill="{Binding SyncStatusColor}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding SyncStatusMessage}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

        <!-- Área de Productos -->
        <GroupBox Header="Catálogo de Productos" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" FontSize="14">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" FontSize="18"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="18" Padding="5" 
                             ToolTip="F1: Buscar producto por nombre o escanear código de barras"
                             KeyDown="SearchBox_KeyDown" GotFocus="SearchBox_GotFocus" />
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding FilteredProducts}" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10" Width="250">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="#007ACC" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Barcode, StringFormat='Cod: {0}'}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Añadir" 
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="70" Height="35" Margin="10,0,0,0" 
                                        Background="{Binding DataContext.PrimaryColorBrush, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <!-- Usar un WrapPanel para que los productos fluyan horizontalmente -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                </ListView>
            </Grid>
        </GroupBox>

        <!-- Área de Carrito y Cobro -->
        
        <Border Grid.Row="0" Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="15" Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Cliente (Opcional)" FontSize="12" Foreground="#6B7280" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Height="35" Padding="10,0" FontSize="14" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" VerticalContentAlignment="Center"/>
                </StackPanel>

                <ListView Grid.Row="1" ItemsSource="{Binding Cart}" BorderThickness="0" Margin="0,10,0,10" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,5,0"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-" Width="24" Height="24" 
                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}"
                                            Background="#FEE2E2" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>
                                    <TextBlock Text="{Binding Quantity}" Width="30" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <Button Content="+" Width="24" Height="24" 
                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}"
                                            Background="#D1FAE5" Foreground="#10B981" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="12"/></Style></Button.Resources>
                                    </Button>
                                </StackPanel>

                                <TextBlock Text="{Binding SubTotal, StringFormat=C}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Margin="10,0" FontSize="14"/>
                                
                                <Button Grid.Column="3" Content="✕" Width="28" Height="28" 
                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}"
                                        Background="#E5E7EB" Foreground="#4B5563" BorderThickness="0" Cursor="Hand" FontWeight="Bold">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="14"/></Style></Button.Resources>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Totales y Descuentos -->
                <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,15,0,10">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="Subtotal:" FontSize="14" Foreground="#6B7280"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat=C}" FontSize="14" Foreground="#374151" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,5" Visibility="{Binding IsDiscountApplied, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Descuento:" FontSize="14" Foreground="#F59E0B"/>
                            <TextBlock Text="{Binding DiscountAmount, StringFormat='-{0:C}'}" FontSize="14" Foreground="#F59E0B" HorizontalAlignment="Right" FontWeight="Bold"/>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="Total:" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="{Binding Total, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Acciones de Orden -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⏸ Suspender (F2)" Command="{Binding SuspendOrderCommand}" Margin="0,0,5,0" Height="45" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                        <Button Grid.Column="1" Content="▶ Retomar (F3)" Command="{Binding ResumeOrderCommand}" Margin="5,0,0,0" Height="45" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                        </Button>
                    </Grid>

                    <Button Grid.Row="1" Content="Cobrar (F12)" 
                        Command="{Binding CheckoutCommand}" 
                        Height="60" FontSize="20" Background="#111827" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand" Margin="0,5,0,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>


    </Grid>
        <!-- Módulos Opcionales -->
        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Test Modificadores UI" Width="160" Height="40" Margin="0,0,10,10" Background="#EC4899" Foreground="White" BorderThickness="0" Cursor="Hand" Click="TestModifiers_Click" />
            <Button Content="Gestión de Mesas" Width="150" Height="40" Margin="0,0,10,10" 
                    Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Visibility="{Binding Settings.Modules.EnableTableManagement, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
                        <Button Content="Probar Impresora" Width="130" Height="40" Margin="0,0,10,10" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding TestPrinterCommand}" />
            <Button Content="Logs" Width="100" Height="40" Margin="0,0,10,10" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenLogsCommand}" />
            <Button Content="Arqueo / Turno (F4)" Width="130" Height="40" Margin="0,0,10,10" Background="#8B5CF6" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenShiftCommand}" />
            <Button Content="Devoluciones (F5)" Width="120" Height="40" Margin="0,0,10,10" Background="#F59E0B" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenReturnsCommand}" />
            <Button Content="Cierre/Reportes (F6)" Width="150" Height="40" Margin="0,0,10,10" Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenReportsCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Usuarios (F7)" Width="100" Height="40" Margin="0,0,10,10" Background="#17A2B8" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenUsersCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Content="Inventario (F8)" Width="150" Height="40" Margin="0,0,10,10" 
                    Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Command="{Binding OpenInventoryCommand}" Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </WrapPanel>

        <!-- Toast Notification Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" 
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,20" Padding="20,15" CornerRadius="8"
                Background="{Binding NotificationColor}"
                Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="4" BlurRadius="8"/>
            </Border.Effect>
            <TextBlock Text="{Binding NotificationMessage}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
