<Window x:Class="PosCore.Views.PrinterConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Impresora" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="25" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Seleccionar Impresora" FontSize="20" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                
                <TextBlock Text="Impresora instalada:" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,5"/>
                <ComboBox x:Name="PrintersCombo" Height="40" Padding="5" FontSize="14" Margin="0,0,0,15" Background="#F9FAFB"/>
                
                <CheckBox x:Name="PrintLogoCheck" Content="Imprimir Logotipo de la Empresa" FontWeight="SemiBold" Margin="0,0,0,20"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Width="100" Height="40" Margin="0,0,10,0" Background="#E5E7EB" Foreground="#374151" FontWeight="Bold" BorderThickness="0" Click="BtnCancel_Click"/>
                    <Button Content="Guardar" Width="120" Height="40" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
