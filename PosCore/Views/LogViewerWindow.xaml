<Window x:Class="PosCore.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visor de Logs" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#F3F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="White" Padding="15" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <TextBlock Text="Visor de Logs del Sistema" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
        </Border>

        <ListBox Grid.Row="1" Margin="15" ItemsSource="{Binding LogLines}" 
                 Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" Foreground="#374151"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="White" Padding="15" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#6B7280" FontStyle="Italic"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding LoadLogsCommand}" Content="Recargar" 
                            Background="#6C757D" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Command="{Binding SendLogsToSupportCommand}" Content="Enviar a Soporte" 
                            Background="#3B82F6" Foreground="White" Padding="15,8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
