<Window x:Class="PosCore.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        mc:Ignorable="d"
        Title="Iniciar Sesión - POS Express" Height="450" Width="450" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F3F4F6">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    
    <Grid>
        <Border Background="White" CornerRadius="12" Margin="30" Padding="30" BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.05" />
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Bienvenido a POS" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="#1F2937"/>
                <TextBlock Text="Ingrese sus credenciales para continuar" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                
                <TextBlock Text="Usuario" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="45" Margin="0,0,0,20" Padding="12,0" FontSize="16" 
                         BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB" Foreground="#111827" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="Contraseña / PIN" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Height="45" Margin="0,0,0,20" Padding="12,0" FontSize="16" 
                         BorderBrush="#D1D5DB" BorderThickness="1" Background="#F9FAFB" Foreground="#111827" VerticalContentAlignment="Center"/>
                
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="14" Margin="0,0,0,20" HorizontalAlignment="Center" TextWrapping="Wrap" FontWeight="Medium"/>
                
                <Button Content="Iniciar Sesión" Command="{Binding LoginCommand}" Height="50" Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,20,0,0" Foreground="#3B82F6" Background="#E5E7EB" BorderThickness="0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
