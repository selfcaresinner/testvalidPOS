<Window x:Class="PosCore.Views.PartialReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Devolución Parcial - POS Express" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="Seleccionar Artículos a Devolver" FontSize="20" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>
                
                <ListView x:Name="ItemsList" Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,0,15">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5" Width="500">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding UnitPrice, StringFormat=C}" VerticalAlignment="Center" Margin="10,0"/>
                                
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBlock Text="Cant: " VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding ReturnQuantity}" Width="40" TextAlignment="Center" Padding="2" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding MaxQuantity, StringFormat='(Max {0})'}" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Width="100" Height="40" Margin="0,0,10,0" Background="#E5E7EB" Foreground="#374151" FontWeight="Bold" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
                    <Button Content="Confirmar" Width="120" Height="40" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnConfirm_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
